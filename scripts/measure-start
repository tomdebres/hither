#!/usr/bin/env python3
"""measure-start: how long Hither's cold start takes to the first focused card (A9).

    scripts/measure-start -s <serial> [--runs N] [--out DIR] [--record S]

For a TV or an emulator that already has Hither installed and signed in (it never installs, signs in, types, or
presses Select or Back). Each run (--runs, default 5): force-stops the app, presses Home and waits for the launcher,
starts recording the screen (`screenrecord`, --record seconds, default 8), starts the app with `am start -W`, and pulls
the recording. It prints one line a run:

- **am start**: the system's TotalTime, from the launch to the app's first frame drawn;
- **settled**: from the first frame of the launch on screen (the first that differs from the launcher) to the frame
  after which the screen no longer changes: Discover drawn with focus on its first card, the rows and their pictures
  in. Hither draws nothing at rest (A3), and Android's screen recorder writes a frame only when the screen changes, so
  the last change in the recording is when the start was over. It is not the focus alone: pictures that come later
  (a real server's posters over the network) end it later. It is claimed only when the screen then stayed still for
  QUIET seconds before the recording ended: a screen still changing at the end has not settled, so the run says so
  (and is left out of the median) instead of giving the recording's end as the time; record longer then;
- the host's and the device's load.

The recordings stay in --out (each run's .mp4), with a strip of the frames before the screen settled, to look at. Each
is removed from the device's /sdcard however its run ends (a failed pull, an error, Ctrl-C).
Nothing else may use the device meanwhile. The serial is required, so it never measures the wrong device. adb is
$ADB, else the Android SDK's, else the one on PATH; ffmpeg and ffprobe come from PATH (Homebrew's).
"""

import argparse
import os
import re
import shutil
import subprocess
import sys
import time

PKG = "com.tomdebres.hither"
W, H = 64, 36  # the frames compared, in grey: enough to see a card move or a row come, cheap to read
CHANGED = 1.0  # mean difference (0-255) above which two frames differ
QUIET = 1.0  # seconds the screen must stay still before the recording's end for the start to count as settled


def adb_path() -> str:
    if os.environ.get("ADB"):
        return os.environ["ADB"]
    sdk = os.environ.get("ANDROID_HOME", os.path.expanduser("~/Library/Android/sdk"))
    local = os.path.join(sdk, "platform-tools", "adb")
    return local if os.access(local, os.X_OK) else "adb"


def frames(video: str) -> list[tuple[float, bytes]]:
    """Each frame's time (s, from the recording's start) and its pixels, small and grey."""
    probe = subprocess.run(
        ["ffprobe", "-v", "error", "-select_streams", "v", "-show_entries", "frame=pts_time", "-of", "csv=p=0", video],
        capture_output=True, text=True, check=True,
    )
    times = [float(t.strip().strip(",")) for t in probe.stdout.split() if t.strip().strip(",")]
    raw = subprocess.run(
        ["ffmpeg", "-v", "error", "-i", video, "-vf", f"scale={W}:{H},format=gray", "-fps_mode", "passthrough", "-f", "rawvideo", "-"],
        capture_output=True, check=True,
    ).stdout
    size = W * H
    pictures = [raw[i : i + size] for i in range(0, len(raw) - size + 1, size)]
    return list(zip(times, pictures))


def differ(a: bytes, b: bytes) -> float:
    return sum(abs(x - y) for x, y in zip(a, b)) / len(a)


def settle(shots: list[tuple[float, bytes]]) -> tuple[float, float, int, int] | None:
    """(launch, settled) times and their frame indexes: the first frame unlike the launcher, the first like the last."""
    if len(shots) < 2:
        return None
    first, last = shots[0][1], shots[-1][1]
    launch = next((i for i, (_, p) in enumerate(shots) if differ(p, first) > CHANGED), None)
    if launch is None:
        return None
    settled = len(shots) - 1
    while settled > launch and differ(shots[settled - 1][1], last) <= CHANGED:
        settled -= 1
    return shots[launch][0], shots[settled][0], launch, settled


def strip(video: str, start: int, end: int, path: str) -> None:
    """The frames from [start] to [end], up to 24 of them, side by side in rows of 6, to look at."""
    step = max(1, -(-(end - start) // 23))
    pick = sorted(set(range(start, end, step)) | {end})
    select = "+".join(f"eq(n\\,{n})" for n in pick)
    rows = (len(pick) + 5) // 6
    subprocess.run(
        ["ffmpeg", "-v", "error", "-y", "-i", video, "-vf", f"select='{select}',scale=480:-1,tile=6x{rows}", "-fps_mode", "passthrough", "-frames:v", "1", path],
        check=False,
    )


def main() -> int:
    parser = argparse.ArgumentParser(usage="scripts/measure-start -s <serial> [--runs N] [--out DIR] [--record S]")
    parser.add_argument("-s", dest="serial")
    parser.add_argument("--runs", type=int, default=5)
    parser.add_argument("--out")
    parser.add_argument("--record", type=int, default=8)
    args = parser.parse_args()
    if not args.serial:
        print("measure-start: name the device with -s <serial> (adb devices)", file=sys.stderr)
        return 2
    for tool in ("ffmpeg", "ffprobe"):
        if not shutil.which(tool):
            print(f"measure-start: {tool} is not on PATH (brew install ffmpeg)", file=sys.stderr)
            return 2
    adb = [adb_path(), "-s", args.serial]

    def dev(*command: str, check: bool = True) -> str:
        return subprocess.run(adb + list(command), capture_output=True, text=True, check=check).stdout.replace("\r", "")

    out = args.out or time.strftime("./measure-start-%Y%m%d-%H%M%S")
    os.makedirs(out, exist_ok=True)
    package = dev("shell", "dumpsys", "package", PKG)
    version = re.search(r"versionName=(\S+)", package)
    if not version:
        print(f"measure-start: {PKG} is not installed on {args.serial}", file=sys.stderr)
        return 1
    dexopt = dev("shell", "dumpsys", "package", "dexopt")
    compiled = re.search(re.escape(f"[{PKG}]") + r"[^\[]*?(\[status=[^\]]*\]\s*\[reason=[^\]]*\])", dexopt)
    model = dev("shell", "getprop", "ro.product.model").strip()
    api = dev("shell", "getprop", "ro.build.version.sdk").strip()
    summary = open(os.path.join(out, "summary.txt"), "w")

    def say(line: str) -> None:
        print(line, flush=True)
        summary.write(line + "\n")
        summary.flush()

    say(
        f"measure-start: {PKG} {version.group(1)} on {args.serial} ({model}, API {api}), {args.runs} cold starts, "
        f"compiled {compiled.group(1) if compiled else '?'}"
    )
    totals, settles = [], []
    for run in range(1, args.runs + 1):
        dev("shell", "am", "force-stop", PKG)
        dev("shell", "input", "keyevent", "3")
        time.sleep(4)
        host_load = os.getloadavg()
        device_load = dev("shell", "cat", "/proc/loadavg").split()[:3]
        remote = f"/sdcard/hither-start-{run}.mp4"
        video = os.path.join(out, f"start-{run}.mp4")
        recorder = subprocess.Popen(adb + ["shell", "screenrecord", "--time-limit", str(args.record), "--bit-rate", "8000000", remote])
        try:
            time.sleep(1.5)
            started = dev("shell", "am", "start", "-W", "-n", f"{PKG}/.MainActivity")
            recorder.wait()
            dev("pull", remote, video)
        finally:
            # However the run ends (a failed pull above all), the recording does not stay on the device: the recorder
            # is let finish or stopped, then its file removed.
            if recorder.poll() is None:
                try:
                    recorder.wait(timeout=args.record + 10)
                except subprocess.TimeoutExpired:
                    recorder.kill()
            dev("shell", "rm", "-f", remote, check=False)
        total = re.search(r"TotalTime: (\d+)", started)
        found = settle(frames(video))
        line = f"run {run}: am start {total.group(1) if total else '?'} ms"
        if total:
            totals.append(int(total.group(1)))
        if found:
            launch, settled, first, last = found
            still = args.record - settled
            if still >= QUIET:
                settles.append(settled - launch)
                line += f", settled {1000 * (settled - launch):.0f} ms after the launch showed (frames {first}-{last})"
            else:
                # The recording runs --record seconds from its first frame and writes a frame only on a change: the last
                # change came {still} s before its end, so the screen was still changing (or had only just stopped).
                line += (
                    f", NOT SETTLED: the screen still changed {1000 * (settled - launch):.0f} ms after the launch showed, "
                    f"{max(0.0, still):.1f} s before the recording ended (under {QUIET:.0f} s still); not counted, record longer"
                )
                print(f"measure-start: run {run}: the screen was still changing at the recording's end (--record {args.record})", file=sys.stderr)
            strip(video, first, last, os.path.join(out, f"start-{run}-frames.png"))
        else:
            line += ", settled: no launch seen in the recording"
        line += f" | host load {' '.join(f'{x:.2f}' for x in host_load)} | device load {' '.join(device_load)}"
        say(line)
    dev("shell", "am", "force-stop", PKG)
    middle = lambda values: sorted(values)[len(values) // 2]
    if totals and settles:
        counted = "" if len(settles) == args.runs else f" ({len(settles)} of {args.runs} runs settled)"
        say(f"median: am start {middle(totals)} ms, settled {1000 * middle(settles):.0f} ms{counted}")
    elif totals:
        say(f"median: am start {middle(totals)} ms; settled: none of the {args.runs} runs settled within its recording")
    print(f"measure-start: recordings in {out}")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except subprocess.CalledProcessError as failure:
        said = (failure.stderr or "").strip() if isinstance(failure.stderr, str) else ""
        print(f"measure-start: {' '.join(map(str, failure.cmd[1:]))} failed (exit {failure.returncode}){': ' + said if said else ''}", file=sys.stderr)
        sys.exit(1)
