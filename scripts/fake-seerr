def providers_list():
    """mapWatchProviderDetails: displayPriority, logoPath, id, name."""
    return [{'displayPriority': i + 1, 'logoPath': f'/fakeprovider{pid}.png', 'id': pid, 'name': name}
            for i, (pid, name) in enumerate(PROVIDERS)]


# -- people: GET /person/{id}, /person/{id}/combined_credits, and people in search --

def people():
    """The people the recorded pages credit (their cast and crew), by TMDB id: name, picture, department,
    the page they are on and their part there."""
    out = {}
    for kind in ('movie', 'tv'):
        data = fixture(kind)
        for c in data['credits'].get('cast') or []:
            out.setdefault(c['id'], {'name': c['name'], 'profilePath': c.get('profilePath'), 'department': 'Acting',
                                     'kind': kind, 'on': data['id'], 'character': c.get('character') or '', 'job': None})
        for c in data['credits'].get('crew') or []:
            out.setdefault(c['id'], {'name': c['name'], 'profilePath': c.get('profilePath'), 'department': c.get('department') or 'Crew',
                                     'kind': kind, 'on': data['id'], 'character': None, 'job': c.get('job')})
    return out


def person(person_id):
    """mapPersonDetails (server/models/Person.ts). Everything but the name and picture is made up, and the
    biography says so. A person TMDB does not know is Seerr's 500, "Unable to retrieve person."."""
    p = people().get(person_id)
    if p is None:
        return 500, {'message': 'Unable to retrieve person.'}
    name = p['name']
    biography = '\n\n'.join([
        f'{name} has no biography on fake-seerr; these paragraphs are made up, to stand where TMDB\'s would. '
        'A real biography runs to several paragraphs, so the page has something to read through with the remote.',
        'The second paragraph of the made-up biography. It is long enough to wrap across a few lines on a television '
        'screen at ten feet, which is what the page has to lay out and let the family read at their own pace.',
        'The third and last paragraph, short.'])
    return 200, {'id': person_id, 'name': name, 'birthday': '19%02d-%02d-%02d' % (50 + person_id % 45, 1 + person_id % 12, 1 + person_id % 28),
                 'deathday': None, 'knownForDepartment': p['department'], 'alsoKnownAs': [],
                 'gender': 0, 'biography': biography, 'popularity': float(person_id % 97), 'placeOfBirth': 'Example City, Nowhere',
                 'profilePath': p['profilePath'], 'adult': False, 'imdbId': None, 'homepage': None}


def credit(title, kind, mediainfo):
    """mapCastCredits / mapCrewCredits' common part, from a catalogue title."""
    film = kind == 'movie'
    out = {'id': title['id'], 'originalLanguage': title.get('originalLanguage'), 'episodeCount': None if film else 10,
           'overview': title.get('overview'), 'originCountry': title.get('originCountry') or [],
           'originalName': None if film else title.get('originalName') or title.get('name'),
           'voteCount': title.get('voteCount', 0), 'name': None if film else title.get('name'), 'mediaType': kind,
           'popularity': title.get('popularity', 0), 'creditId': 'fake%010x' % made_up('credit', kind, title['id']),
           'backdropPath': title.get('backdropPath'), 'firstAirDate': None if film else title.get('firstAirDate'),
           'voteAverage': title.get('voteAverage', 0), 'genreIds': title.get('genreIds') or [],
           'posterPath': title.get('posterPath'), 'originalTitle': title.get('originalTitle') or title.get('title') if film else None,
           'video': False, 'title': title.get('title') if film else None, 'adult': False,
           'releaseDate': title.get('releaseDate') if film else None}
    if mediainfo is not None:
        out['mediaInfo'] = mediainfo
    return out


def credits_of(person_id):
    """GET /person/{id}/combined_credits: the page the person is credited on, then made-up others (one
    title in four of either type for the cast, one in five for the crew), each with its record as a list
    carries it (Media.getRelatedMedia)."""
    p = people().get(person_id)
    if p is None:
        return 500, {'message': 'Unable to retrieve combined credits.'}
    acting = p['department'] == 'Acting'
    chosen = []
    for kind in ('movie', 'tv'):
        for t in catalogue(kind):
            if (kind == p['kind'] and t['id'] == p['on']) or has_tag('cast' if acting else 'crew', person_id, t['id'], 4 if acting else 5):
                chosen.append((kind, t))
    out = []
    with lock:
        for kind, t in chosen:
            media = current_media(kind, t['id'])
            item = credit(t, kind, in_list(media) if media is not None else None)
            if acting:
                item['character'] = p['character'] if t['id'] == p['on'] else 'Made-up part %d' % (made_up(person_id, t['id']) % 90 + 10)
            else:
                item.update(department=p['department'], job=p['job'] if t['id'] == p['on'] else 'Producer')
            out.append(item)
    return 200, {'cast': out if acting else [], 'crew': [] if acting else out, 'id': person_id}


def people_matching(words):
    """Seerr's search's people (mapPersonResult): those whose name holds the words, with what they are
    known for (up to three of their titles, mapMovieResult / mapTvResult without a record)."""
    out = []
    for pid, p in people().items():
        if words and words in p['name'].lower():
            known = [t for kind in ('movie', 'tv') for t in catalogue(kind)
                     if t['id'] == p['on'] or has_tag('cast' if p['department'] == 'Acting' else 'crew', pid, t['id'], 4)][:3]
            out.append({'id': pid, 'name': p['name'], 'popularity': float(pid % 97), 'adult': False, 'mediaType': 'person',
                        'profilePath': p['profilePath'], 'knownFor': [{k: v for k, v in t.items() if k != 'mediaInfo'} for t in known]})
    return out


# -- a title's ratings, and its Recommendations and Similar rows --

def title_name(kind, tmdb_id):
    title = listed(kind, tmdb_id)
    return (title or {}).get('title' if kind == 'movie' else 'name') or page_fixture(kind, tmdb_id).get('title' if kind == 'movie' else 'name')


def rt_rating(kind, tmdb_id):
    """RTRating (server/api/rating/rottentomatoes.ts), made up from the id."""
    h = made_up('rt', kind, tmdb_id)
    critics, audience = 30 + h % 70, 25 + (h // 101) % 75
    data = page_fixture(kind, tmdb_id)
    year = (data.get('releaseDate') or data.get('firstAirDate') or '')[:4]
    return {'title': title_name(kind, tmdb_id), 'year': int(year) if year.isdigit() else None,
            'criticsRating': 'Certified Fresh' if critics >= 75 else 'Fresh' if critics >= 60 else 'Rotten',
            'criticsScore': critics, 'audienceRating': 'Upright' if audience >= 60 else 'Spilled', 'audienceScore': audience,
            'url': f'https://example.invalid/rt/{kind}/{tmdb_id}'}


def ratings(kind, tmdb_id):
    """GET /movie/{id}/ratingscombined ({rt, imdb}, each only when found; 404 "No ratings found." with neither)
    and GET /tv/{id}/ratings (the RTRating, or 404 "Rotten Tomatoes ratings not found."), made up from the
    id; /fake/ratings?rt=0&imdb=0 takes either away."""
    rt = rt_rating(kind, tmdb_id) if ratings_on['rt'] else None
    if kind == 'tv':
        return (200, rt) if rt else (404, {'message': 'Rotten Tomatoes ratings not found.'})
    h = made_up('imdb', tmdb_id)
    imdb = {'title': title_name(kind, tmdb_id), 'url': f'https://example.invalid/imdb/{tmdb_id}',
            'criticsScore': round(4.5 + (h % 50) / 10, 1), 'criticsScoreCount': 1000 + h % 90000} if ratings_on['imdb'] else None
    if not rt and not imdb:
        return 404, {'message': 'No ratings found.'}
    return 200, {k: v for k, v in (('rt', rt), ('imdb', imdb)) if v}


def related(kind, tmdb_id, which, page):
    """GET /movie|tv/{id}/similar and /recommendations: titles of the same type, the title itself aside,
    in an order fixed by the title's id (Recommendations the other way round), 20 a page, two pages at
    most, each with its record."""
    pool = [t for t in catalogue(kind) if t['id'] != tmdb_id]
    start = tmdb_id % len(pool) if pool else 0
    order = pool[start:] + pool[:start]
    if which == 'recommendations':
        order = list(reversed(order))
    order = order[:2 * BROWSE_PAGE]
    page = max(1, page)
    return 200, {'page': page, 'totalPages': max(1, math.ceil(len(order) / BROWSE_PAGE)), 'totalResults': len(order),
                 'results': with_records(order[(page - 1) * BROWSE_PAGE:page * BROWSE_PAGE])}


# -- issues: POST /issue, GET /issue, GET /issue/{id} (server/routes/issue.ts) --

def someone_elses_issue():
    """A made-up issue by another user (user 1): a subtitle problem on the recorded series in the library
    (Phineas and Ferb), still open. Only an account that may see others' issues sees it."""
    series = fixture('tv-in-library')
    return {'key': ('tv', series['id']),
            'issue': {'id': 41, 'issueType': 3, 'status': ISSUE_OPEN, 'problemSeason': 1, 'problemEpisode': 2,
                      'createdAt': '2025-12-02T00:00:00.000Z', 'updatedAt': '2025-12-02T00:00:00.000Z',
                      'createdBy': OWNER, 'modifiedBy': None,
                      'comments': [{'id': 42, 'message': 'The subtitles run two seconds late.', 'user': OWNER,
                                    'createdAt': '2025-12-02T00:00:00.000Z', 'updatedAt': '2025-12-02T00:00:00.000Z'}]}}


def every_issue():
    """Every issue on the server, each with its title's record as it is now (Issue's eager media: the
    columns and seasons). Runs under the lock."""
    out = []
    for entry in made['issues'] + [someone_elses_issue()]:
        media = current_media(*entry['key'])
        out.append(dict(entry['issue'], media=dict(columns(media), seasons=media['seasons']) if media else None))
    return out


def issues_of(key):
    return [i for i in every_issue() if i['media'] and (i['media']['mediaType'], i['media']['tmdbId']) == key]


def record_by_id(media_id):
    """The library record with this Media id, or None. Runs under the lock."""
    return next((m for m in all_records().values() if m['id'] == media_id), None)


def create_issue(body, who):
    """POST /issue: guarded by Manage Issues or Create Issues (else isAuthenticated's 403), the title by
    its library record's id (404 "Media does not exist."), the user's own unless Manage Issues; the
    message is the first comment. 201 with the issue. Runs under the lock."""
    held, uid = held_by(who)
    if not has(held, MANAGE_ISSUES, CREATE_ISSUES):
        return 403, NO_RIGHT
    number = lambda v: isinstance(v, int) and not isinstance(v, bool)
    if not isinstance(body, dict) or not number(body.get('issueType')) or not isinstance(body.get('message'), str) \
            or not number(body.get('mediaId')):
        return 400, {'message': 'request/body must hold issueType (number), message (string) and mediaId (number)'}
    media = record_by_id(body['mediaId'])
    if media is None:
        return 404, {'message': 'Media does not exist.'}
    if body.get('userId') is not None and body['userId'] != uid and not has(held, MANAGE_ISSUES):
        return 403, {'message': 'You do not have permission to create an issue on behalf of another user.'}
    at, user = now(), public_user(who)
    issue = {'id': next_id(), 'issueType': body['issueType'], 'status': ISSUE_OPEN,
             'problemSeason': body.get('problemSeason') or 0, 'problemEpisode': body.get('problemEpisode') or 0,
             'createdAt': at, 'updatedAt': at, 'createdBy': user, 'modifiedBy': None,
             'comments': [{'id': next_id(), 'message': body['message'], 'user': user, 'createdAt': at, 'updatedAt': at}]}
    made['issues'].append({'key': (media['mediaType'], media['tmdbId']), 'issue': issue})
    sys.stderr.write(f'fake-seerr: issue #{issue["id"]} type {issue["issueType"]} on {media["mediaType"]}:{media["tmdbId"]}\n')
    return 201, dict(issue, media=dict(columns(media), seasons=media['seasons']))


def issue_list(query, who):
    """GET /issue: guarded by Manage, View or Create Issues; open, resolved or both (filter), newest first by
    createdAt or updatedAt (sort=modified), paged by take (10) and skip. Without Manage or View Issues the
    account sees its own only, and asking for another's (createdBy) is a 403. Runs under the lock."""
    held, uid = held_by(who)
    if not has(held, MANAGE_ISSUES, VIEW_ISSUES, CREATE_ISSUES):
        return 403, NO_RIGHT
    arg = lambda name, default=None: (query.get(name) or [default])[0]
    take, skip = int(arg('take', '10')), int(arg('skip', '0'))
    by = int(arg('createdBy')) if arg('createdBy') else None
    statuses = {'open': {ISSUE_OPEN}, 'resolved': {ISSUE_RESOLVED}}.get(arg('filter'), {ISSUE_OPEN, ISSUE_RESOLVED})
    chosen = [i for i in every_issue() if i['status'] in statuses]
    if not has(held, MANAGE_ISSUES, VIEW_ISSUES):
        if by and by != uid:
            return 403, {'message': 'You do not have permission to view issues reported by other users'}
        chosen = [i for i in chosen if i['createdBy']['id'] == uid]
    elif by:
        chosen = [i for i in chosen if i['createdBy']['id'] == by]
    field = 'updatedAt' if arg('sort') == 'modified' else 'createdAt'
    chosen.sort(key=lambda i: (i[field], i['id']), reverse=True)
    return 200, {'pageInfo': {'pages': math.ceil(len(chosen) / take) if take else 0, 'pageSize': take,
                              'results': len(chosen), 'page': math.ceil(skip / take) + 1 if take else 1},
                 'results': chosen[skip:skip + take]}


def one_issue(issue_id, who):
    """GET /issue/{id}: guarded as the list; 500 "Issue not found." for one it does not hold, 403 for
    another's without Manage or View Issues. Runs under the lock."""
    held, uid = held_by(who)
    if not has(held, MANAGE_ISSUES, VIEW_ISSUES, CREATE_ISSUES):
        return 403, NO_RIGHT
    issue = next((i for i in every_issue() if i['id'] == issue_id), None)
    if issue is None:
        return 500, {'message': 'Issue not found.'}
    if issue['createdBy']['id'] != uid and not has(held, MANAGE_ISSUES, VIEW_ISSUES):
        return 403, {'message': 'You do not have permission to view this issue.'}
    return 200, issue


# ---- CSRF, as Seerr's csurf with its secret in a cookie ------------------------------------------

def csrf_token(secret, salt=None):
    salt = salt or secrets.token_hex(4)
    digest = base64.urlsafe_b64encode(hashlib.sha1(f'{salt}-{secret}'.encode()).digest()).decode().rstrip('=')
    return f'{salt}-{digest}'


def csrf_valid(token, secret):
    if not token or not secret or '-' not in token:
        return False
    return hmac.compare_digest(token, csrf_token(secret, token.split('-', 1)[0]))


# ---- pictures for /imageproxy -------------------------------------------------------------------

images = {}


def png(width, height, seed):
    """A vertical gradient in one hue per file, darker towards the foot, as a PNG."""
    h = hashlib.sha256(seed.encode()).digest()
    top = (h[0] // 2 + 60, h[1] // 2 + 40, h[2] // 2 + 80)
    raw = bytearray()
    for y in range(height):
        f = 1 - 0.75 * y / max(1, height - 1)
        raw += b'\x00' + bytes((int(top[0] * f), int(top[1] * f), int(top[2] * f))) * width

    def chunk(kind, data):
        return struct.pack('>I', len(data)) + kind + data + struct.pack('>I', zlib.crc32(kind + data) & 0xffffffff)

    return (b'\x89PNG\r\n\x1a\n' + chunk(b'IHDR', struct.pack('>IIBBBBB', width, height, 8, 2, 0, 0, 0))
            + chunk(b'IDAT', zlib.compress(bytes(raw), 6)) + chunk(b'IEND', b''))


def size_of(segment):
    m = re.match(r'^w(\d+)_and_h(\d+)', segment)
    if m:
        return int(m.group(1)), int(m.group(2))
    m = re.match(r'^w(\d+)$', segment)
    if m:
        return int(m.group(1)), int(m.group(1)) * 3 // 2
    return 300, 450


class H(BaseHTTPRequestHandler):
    protocol_version = 'HTTP/1.1'

    def _cookie(self, name):
        m = re.search(r'(?:^|;\s*)' + re.escape(name) + r'=([^;\s]+)', self.headers.get('Cookie') or '')
        return m.group(1) if m else None

    def _begin(self, path):
        """Per request (one connection carries several): whether the CSRF check applies, the
        secret the request brought, and the cookies the answer sets, as csurf does."""
        self.set_cookies = []
        self.who = None
        with lock:
            csrf, secure = switches['csrf'], switches['secure']
        self.csrf_on = csrf and not path.startswith(('/fake/', '/imageproxy/', '/plextv/'))
        self.csrf_secret = self._cookie('_csrf') if self.csrf_on else None
        if self.csrf_on:
            secret = self.csrf_secret
            if secret is None:
                secret = secrets.token_urlsafe(18)
                self.set_cookies.append(f'_csrf={secret}; Path=/; HttpOnly; SameSite=Strict' + ('; Secure' if secure else ''))
            self.set_cookies.append(f'XSRF-TOKEN={csrf_token(secret)}; Path=/; SameSite=Strict' + ('; Secure' if secure else ''))

    def _send(self, status, body, cookie=None, content_type='application/json; charset=utf-8'):
        data = body if isinstance(body, bytes) else json.dumps(body, separators=(',', ':')).encode()
        self.send_response(status)
        self.send_header('Content-Type', content_type)
        self.send_header('Content-Length', str(len(data)))
        for c in getattr(self, 'set_cookies', []) + ([cookie] if cookie else []):
            self.send_header('Set-Cookie', c)
        self.end_headers()
        self.wfile.write(data)

    def _session(self):
        """'live', 'none' (no cookie sent) or 'stale' (a cookie the server does not know); a live
        session's account is left in self.who."""
        self.who = None
        sid = self._cookie('connect.sid')
        if sid is None:
            return 'none'
        with lock:
            self.who = sessions.get(sid)
        return 'live' if self.who else 'stale'

    def _signed_out(self, state):
        # Seerr's API validator wants the cookie (401); with one, its isAuthenticated finds no
        # user behind it and answers 403, auth/me included.
        if state == 'none':
            return self._send(401, fixture('error-401'))
        return self._send(403, {'status': 403, 'error': 'You do not have permission to access this endpoint'})

    def do_GET(self):
        url = urlsplit(self.path)
        path, query = url.path, parse_qs(url.query)
        self._begin(path)
        if path.startswith('/imageproxy/'):
            return self._image(path)
        if path.startswith('/plextv/'):
            with lock:
                answer = plex_tv('GET', path, dict(self.headers))
            return self._send(*answer)
        if path == '/api/v1/status':
            # server/routes/index.ts: no session needed (M8 reads the version for Quick Connect).
            with lock:
                version = signin['version']
            return self._send(200, {'version': version, 'commitTag': 'fake', 'restartRequired': False})
        if path == '/api/v1/auth/jellyfin/quickconnect/check':
            with lock:
                status, answer, _ = quick_connect(path, query, None)
            return self._send(status, answer)
        if path == '/api/v1/settings/public':
            with lock:
                public = settings_public()
            return self._send(200, public)
        if path in ('/api/v1', '/api/v1/'):
            # The API's root (server/routes/index.ts): no session needed. Clients probe it to tell a Seerr.
            return self._send(200, {'api': 'Seerr API', 'version': '1.0'})
        if not path.startswith('/api/v1/'):
            return self._send(404, {'message': 'Not Found'})
        if forbid[0]:
            return self._proxy_refuses()
        state = self._session()
        if state != 'live':
            return self._signed_out(state)
        if path == '/api/v1/auth/me':
            with lock:
                user = me(self.who)
            return self._send(200, user)
        if path in ('/api/v1/discover/movies', '/api/v1/discover/tv') and any(k != 'page' for k in query):
            return self._send(*browse('movie' if path.endswith('movies') else 'tv', query))
        if path in PATHS:
            return self._discover(PATHS[path], int((query.get('page') or ['1'])[0]))
        m = re.match(r'^/api/v1/discover/(movies/studio|tv/network)/(\d+)$', path)
        if m:
            film = m.group(1).startswith('movies')
            status, answer = browse('movie' if film else 'tv', query, studio=m.group(2) if film else None,
                                    network=None if film else m.group(2))
            answer['studio' if film else 'network'] = (studio_of if film else network_of)(int(m.group(2)))
            return self._send(status, answer)
        if path == '/api/v1/search':
            return self._search(unquote((query.get('query') or [''])[0]))
        m = re.match(r'^/api/v1/(movie|tv)/(\d+)$', path)
        if m:
            return self._send(200, details(m.group(1), int(m.group(2)), self.who))
        m = re.match(r'^/api/v1/(movie|tv)/(\d+)/(similar|recommendations|ratings|ratingscombined)$', path)
        if m and (m.group(3) not in ('ratings', 'ratingscombined') or m.group(3) == ('ratingscombined' if m.group(1) == 'movie' else 'ratings')):
            kind, tmdb_id = m.group(1), int(m.group(2))
            if m.group(3).startswith('ratings'):
                return self._send(*ratings(kind, tmdb_id))
            return self._send(*related(kind, tmdb_id, m.group(3), int((query.get('page') or ['1'])[0])))
        m = re.match(r'^/api/v1/person/(\d+)(/combined_credits)?$', path)
        if m:
            return self._send(*(credits_of if m.group(2) else person)(int(m.group(1))))
        if path == '/api/v1/settings/discover':
            with lock:
                answer = copy.deepcopy(sliders)
            return self._send(200, answer)
        if path == '/api/v1/media':
            return self._send(*library(query))
        m = re.match(r'^/api/v1/genres/(movie|tv)$', path)
        if m:
            return self._send(200, [{'id': i, 'name': n} for i, n in GENRES[m.group(1)]])
        if path == '/api/v1/languages':
            return self._send(200, [{'iso_639_1': c, 'english_name': e, 'name': n} for c, e, n in LANGUAGES])
        if path == '/api/v1/watchproviders/regions':
            return self._send(200, [{'iso_3166_1': c, 'english_name': e, 'native_name': n} for c, e, n in REGIONS])
        if path in ('/api/v1/watchproviders/movies', '/api/v1/watchproviders/tv'):
            return self._send(200, providers_list())
        m = re.match(r'^/api/v1/collection/(\d+)$', path)
        if m:
            return self._send(*collection_route(int(m.group(1))))
        m = re.match(r'^/api/v1/keyword/(\d+)$', path)
        if m:
            name = known_keywords().get(int(m.group(1)))
            return self._send(*((200, {'id': int(m.group(1)), 'name': name}) if name else (500, {'message': 'Unable to retrieve keyword data.'})))
        m = re.match(r'^/api/v1/user/(\d+)/quota$', path)
        if m:
            with lock:
                answer = quota_route(int(m.group(1)), self.who)
            return self._send(*answer)
        if path == '/api/v1/issue':
            with lock:
                answer = issue_list(query, self.who)
            return self._send(*answer)
        m = re.match(r'^/api/v1/issue/(\d+)$', path)
        if m:
            with lock:
                answer = one_issue(int(m.group(1)), self.who)
            return self._send(*answer)
        if path == '/api/v1/request/count':
            return self._send(*request_count())
        if path == '/api/v1/request':
            return self._send(*request_list(query, self.who))
        self._send(404, {'message': 'Not Found'})

    def _proxy_refuses(self):
        """What nginx in front of a server answers when it will not pass a call on."""
        page = (b'<html>\r\n<head><title>403 Forbidden</title></head>\r\n<body>\r\n'
                b'<center><h1>403 Forbidden</h1></center>\r\n<hr><center>nginx</center>\r\n</body>\r\n</html>\r\n')
        return self._send(403, page, content_type='text/html')

    def _discover(self, row, page):
        with lock:
            fail, empty, slow = row in rows['fail'], row in rows['empty'], row in rows['slow']
            delay, morefail = rows['delay'], rows['morefail']
        if delay and (slow or not rows['slow']):
            time.sleep(delay)
        if fail or (morefail and page > 1):
            return self._send(500, {'message': 'Unable to retrieve this row.'})
        if empty:
            return self._send(200, {'page': 1, 'totalPages': 1, 'totalResults': 0, 'results': []})
        if page < 1 or page > PAGES:
            return self._send(200, {'page': page, 'totalPages': PAGES, 'totalResults': 0, 'results': []})
        self._send(200, page_of(row, page))

    def _search(self, text):
        words = text.lower().strip()
        found = [r for r in every_title() if words and words in (r.get('title') or r.get('name') or '').lower()]
        # Seerr's search is TMDB's multi search: people too (mapPersonResult), after the titles here.
        found = with_records(found) + people_matching(words)
        self._send(200, {'page': 1, 'totalPages': 1, 'totalResults': len(found), 'results': found})

    def _image(self, path):
        parts = path.split('/')  # ['', 'imageproxy', 'tmdb', 't', 'p', size, file]
        if '//' in path[len('/imageproxy'):] or '://' in path:
            return self._send(403, {'message': 'Invalid URL for image proxy.'})
        if len(parts) < 4 or parts[2] not in ('tmdb', 'tvdb'):
            return self._send(400, {'message': 'Unsupported image type.'})
        width, height = size_of(parts[5] if len(parts) > 6 else '')
        key = (width, height, parts[-1])
        with lock:
            data = images.get(key)
        if data is None:
            data = png(width, height, parts[-1])
            with lock:
                images[key] = data
        self._send(200, data, content_type='image/png')

    def _switch(self, path, query):
        """The fake's own switches (see the docstring); None for any other path."""
        arg = lambda name: (query.get(name) or [''])[0]
        on = lambda name: arg(name) in ('1', 'true', 'on')
        with lock:
            if path == '/fake/cookies':
                cookie_life[0] = int(arg('life') or COOKIE_LIFE)
                return 200, {'cookieLife': cookie_life[0]}
            if path == '/fake/expire':
                sessions.clear()
                return 200, {'status': 'every session has ended'}
            if path == '/fake/forbid':
                forbid[0] = arg('on') != '0'
                return 200, {'forbid': forbid[0]}
            if path == '/fake/rows':
                names = lambda key: {x for x in ','.join(query.get(key, [])).split(',') if x}
                rows.update(fail=names('fail'), empty=names('empty'), slow=names('slow'),
                            delay=float(arg('delay') or 0), morefail=arg('morefail') == '1')
                return 200, {k: sorted(v) if isinstance(v, set) else v for k, v in rows.items()}
            if path == '/fake/requests':
                listing.update(fail=on('fail'), empty=on('empty'), morefail=on('morefail'), others=int(arg('others') or 0),
                               household=on('household'))
                return 200, dict(listing)
            if path == '/fake/account':
                if 'fourk' in query and arg('fourk') not in FOURK:
                    return 400, {'message': f'fourk is one of {", ".join(FOURK)}'}
                if 'autoapprove' in query:
                    account['autoapprove'] = on('autoapprove')
                if 'view' in query:
                    account['view'] = on('view')
                if 'manage' in query:
                    account['manage'] = on('manage')
                if 'fourk' in query:
                    account['fourk'] = arg('fourk')
                for name in ('recent', 'createissues', 'viewissues'):
                    if name in query:
                        account[name] = on(name)
                for kind in ('movie', 'tv'):
                    limit, days = account['quota'][kind]
                    if kind + 'quota' in query:
                        limit = int(arg(kind + 'quota') or 0)
                    if kind + 'days' in query:
                        days = int(arg(kind + 'days') or 0)
                    account['quota'] = dict(account['quota'], **{kind: (limit, days)})
                return 200, dict(account, permissions=permissions())
            if path == '/fake/approver':
                if arg('rights') not in APPROVER_RIGHTS:
                    return 400, {'message': f'rights is one of {", ".join(APPROVER_RIGHTS)}'}
                account['approver'] = arg('rights')
                return 200, {'rights': account['approver'], 'permissions': approver_permissions()}
            if path == '/fake/server':
                for short, key in SERVER_KEYS.items():
                    if short in query:
                        server[key] = on(short)
                for short in ('csrf', 'strict', 'secure'):
                    if short in query:
                        switches[short] = on(short)
                if 'region' in query:
                    server['streamingRegion'] = arg('region').upper()
                public = settings_public()
                return 200, dict({short: public[key] for short, key in SERVER_KEYS.items()}, region=public['streamingRegion'], **switches)
            if path == '/fake/move':
                return move(query)
            if path == '/fake/download':
                return download(query)
            if path == '/fake/ratings':
                for name in ('rt', 'imdb'):
                    if name in query:
                        ratings_on[name] = on(name)
                return 200, dict(ratings_on)
            if path == '/fake/discover':
                preset = arg('preset')
                if preset not in ('', 'default', 'custom'):
                    return 400, {'message': 'preset is default or custom'}
                if preset:
                    sliders[:] = custom_sliders() if preset == 'custom' else default_sliders()
                hidden = {int(n) for n in arg('hide').split(',') if n.strip().isdigit()}
                for row in sliders:
                    if row['id'] in hidden:
                        row['enabled'] = False
                order = [int(n) for n in arg('order').split(',') if n.strip().isdigit()]
                if order:
                    by_id = {row['id']: row for row in sliders}
                    if sorted(order) != sorted(by_id):
                        return 400, {'message': 'order names every slider id once'}
                    sliders[:] = [dict(by_id[n], order=i) for i, n in enumerate(order)]
                return 200, copy.deepcopy(sliders)
            if path == '/fake/ask':
                m = re.match(r'^(movie|tv):(\d+)$', arg('title'))
                if not m:
                    return 400, {'message': 'title is movie:<tmdb id> or tv:<tmdb id>'}
                body = {'mediaType': m.group(1), 'mediaId': int(m.group(2)), 'is4k': False}
                if m.group(1) == 'tv':
                    body['seasons'] = [int(n) for n in (arg('seasons') or '1').split(',')]
                status, answer = make_request(body, 'family')
                # a switch answers 200 when it did what it was asked; the request's own refusals as Seerr's
                return (200 if status == 201 else status), answer
            if path == '/fake/signin':
                kind = arg('type')
                if kind and kind not in SERVER_TYPES:
                    return 400, {'message': f'type is one of {", ".join(SERVER_TYPES)}'}
                keys = {'local': 'localLogin', 'mediaserver': 'mediaServerLogin', 'newlogin': 'newPlexLogin'}
                for short, key in keys.items():
                    if short in query:
                        signin['switches'][key] = on(short)
                if kind:
                    signin['switches']['mediaServerType'] = SERVER_TYPES[kind]
                if 'external' in query:
                    signin['switches']['jellyfinExternalHost'] = arg('external')
                if 'version' in query:
                    signin['version'] = arg('version')
                public = settings_public()
                return 200, dict({k: public[v] for k, v in keys.items()}, type=public['mediaServerType'],
                                 external=public['jellyfinExternalHost'], version=signin['version'])
            if path == '/fake/quickconnect':
                if 'off' in query:
                    signin['qc_off'] = on('off')
                if 'life' in query:
                    signin['qc_life'] = float(arg('life') or QC_LIFE)
                return 200, {'off': signin['qc_off'], 'life': signin['qc_life'],
                             'codes': [e['code'] for e in signin['qc'].values() if qc_live(e)]}
            if path == '/fake/quickconnect/approve':
                return qc_approve(query)
            if path == '/fake/plex':
                if 'down' in query:
                    signin['plex_down'] = on('down')
                if 'life' in query:
                    signin['pin_life'] = float(arg('life') or PIN_LIFE)
                live = [p['code'] for p in signin['pins'].values() if time.time() < p['created'] + signin['pin_life']]
                return 200, {'down': signin['plex_down'], 'life': signin['pin_life'], 'codes': live,
                             'seen': signin['plex_seen'][-20:]}
            if path == '/fake/plex/link':
                return plex_link(query)
            if path == '/fake/reset':
                reset()
                return 200, {'status': 'every request forgotten, every switch as recorded'}
        return None

    def do_POST(self):
        url = urlsplit(self.path)
        path, query = url.path, parse_qs(url.query)
        n = int(self.headers.get('Content-Length') or 0)
        raw = self.rfile.read(n) if n else b''
        self._begin(path)
        if path.startswith('/fake/'):
            answer = self._switch(path, query)
            return self._send(*answer) if answer else self._send(404, {'message': 'No such switch.'})
        if path.startswith('/plextv/'):
            with lock:
                answer = plex_tv('POST', path, dict(self.headers))
            return self._send(*answer)
        if path.startswith('/api/v1/') and forbid[0]:
            return self._proxy_refuses()
        if not self._csrf_passes():
            return self._send(403, {'message': 'invalid csrf token'})
        try:
            body = json.loads(raw or b'{}')
        except ValueError:
            return self._send(400, {'message': 'Unexpected token in JSON'})
        if path == '/api/v1/auth/local':
            # Seerr finds the user by email (lowercased) and checks that user's password.
            email = str(body.get('email') or '').strip().lower() if isinstance(body, dict) else ''
            password = body.get('password') if isinstance(body, dict) else None
            who = ('approver' if password == APPROVER_PASSWORD else None) if email == APPROVER_EMAIL else (
                'family' if password == PASSWORD else None)
            if who:
                sid = 's%3Afake-' + secrets.token_hex(8)
                with lock:
                    sessions[sid] = who
                expires = formatdate(time.time() + cookie_life[0], usegmt=True)
                # Seerr's own body here is a cut-down user whose permissions are not to be trusted.
                signed = fixture('auth-local') if who == 'family' else dict(fixture('auth-local'), id=APPROVER_ID, displayName='Approver', requestCount=0)
                return self._send(200, signed, cookie=f'connect.sid={sid}; Path=/; Expires={expires}; HttpOnly')
            return self._send(403, fixture('error-403-sign-in'))
        if path in ('/api/v1/auth/jellyfin', '/api/v1/auth/plex') or path.startswith('/api/v1/auth/jellyfin/quickconnect/'):
            with lock:
                if path == '/api/v1/auth/jellyfin':
                    status, answer, who = jellyfin_sign_in(body)
                elif path == '/api/v1/auth/plex':
                    status, answer, who = plex_sign_in(body)
                elif path.endswith(('/initiate', '/authenticate')):
                    status, answer, who = quick_connect(path, query, body)
                else:
                    status, answer, who = 404, {'message': 'Not Found'}, None
                cookie = start_session(who) if who else None
            sys.stderr.write(f'fake-seerr: {path} -> {status}{" as " + who if who else ""}\n')
            return self._send(status, answer, cookie=cookie)
        if path == '/api/v1/auth/logout':
            with lock:
                sessions.pop(self._cookie('connect.sid'), None)
            return self._send(200, {'status': 'ok'})
        state = self._session()
        if state != 'live':
            return self._signed_out(state)
        m = re.match(r'^/api/v1/request/(\d+)/([a-z]+)$', path)
        if m and m.group(2) != 'retry':
            with lock:
                status, answer = decide_route(int(m.group(1)), m.group(2), self.who)
            return self._send(status, answer)
        if path == '/api/v1/request':
            problem = invalid(body)
            if problem:
                where, words = problem
                return self._send(400, {'message': f'request/body{where} {words}',
                                        'errors': [{'path': f'/body{where}', 'message': words}]})
            with lock:
                status, answer = make_request(body, self.who)
            note = f"#{answer['id']} {'approved' if answer['status'] == R_APPROVED else 'pending'}" if status == 201 else answer.get('message')
            sys.stderr.write(f'fake-seerr: request {json.dumps(body, separators=(",", ":"))} -> {status} {note}\n')
            return self._send(status, answer)
        if path == '/api/v1/issue':
            with lock:
                answer = create_issue(body, self.who)
            return self._send(*answer)
        self._send(404, {'message': 'Not Found'})

    def _csrf_passes(self):
        """csurf: with CSRF protection on, a write without the token matching the secret is refused."""
        if not self.csrf_on:
            return True
        token = next((self.headers[h] for h in ('X-XSRF-TOKEN', 'X-CSRF-TOKEN', 'CSRF-Token', 'XSRF-Token') if self.headers.get(h)), None)
        return csrf_valid(token, self.csrf_secret)

    def do_DELETE(self):
        """DELETE /request/{id}: the session first (isAuthenticated()), then the route's own rule."""
        url = urlsplit(self.path)
        path = url.path
        n = int(self.headers.get('Content-Length') or 0)
        if n:
            self.rfile.read(n)
        self._begin(path)
        if path.startswith('/api/v1/') and forbid[0]:
            return self._proxy_refuses()
        if not self._csrf_passes():
            return self._send(403, {'message': 'invalid csrf token'})
        state = self._session()
        if state != 'live':
            return self._signed_out(state)
        m = re.match(r'^/api/v1/request/(\d+)$', path)
        if m:
            with lock:
                status, answer = remove_request(int(m.group(1)), self.who)
            sys.stderr.write(f'fake-seerr: remove request #{m.group(1)} -> {status}\n')
            return self._send(status, answer)
        self._send(404, {'message': 'Not Found'})

    def log_message(self, fmt, *args):
        # Which account a call came as, so a proof can show the family's reads stay the family's (M5).
        who = getattr(self, 'who', None)
        sys.stderr.write('fake-seerr: %s%s\n' % (fmt % args, f' as {who}' if who else ''))


if __name__ == '__main__':
    host = sys.argv[2] if len(sys.argv) > 2 else '127.0.0.1'
    httpd = ThreadingHTTPServer((host, int(sys.argv[1]) if len(sys.argv) > 1 else 5056), H)
    port = httpd.server_address[1]
    print(f'fake-seerr on {host}:{port} (10.0.2.2:{port} from an emulator), password "{PASSWORD}"', flush=True)
    httpd.serve_forever()
