#!/bin/bash
# measure-discover: how smoothly Discover moves under a fixed run of D-pad presses.
#
#   scripts/measure-discover -s <serial> [--passes N] [--out DIR] [--settle S] [--down N]
#
# For a TV or an emulator that already has Hither installed and signed in (it never installs,
# signs in, types, or presses Select or Back). It force-stops the app, starts it, waits
# --settle seconds (default 12) for the rows and posters, then runs the same press sequence
# --passes times (default 2: the first just after launch, the second warm), and once more
# sampled (below). Before each pass it resets `dumpsys gfxinfo`; after it, it saves the full
# dump and prints one line:
# frames, janky frames (the deadline count where the device has one, and the legacy count),
# the frame-time percentiles, slow UI thread and missed deadlines, GPU p50/p90, and the GPU
# image-texture count (DECISIONS 57: 0.1.0-m1 left thousands of shadow bitmaps behind).
# The sampled pass reads `gfxinfo framestats` every second to get the UI thread's own time
# for every frame; the reading costs the device frames, so that pass gives the UI-thread
# figure and nothing else. The host's `uptime` and the device's load are recorded beside each pass, because the
# Studio's load swings from 50 to 950 and an emulator's frames swing with it.
#
# The sequence starts and ends on Trending's first card: along Trending, down a row at a time
# to Upcoming Films with a run along each, then back along each row and up again. 70 presses,
# about 0.5 s apart, about 45 s. Nothing else may use the device meanwhile.
#
# Every build is measured over that same path, whatever rows lie above Trending (DECISIONS 90).
# Since 0.4.1, an account with requests has Recent Requests above Trending, and focus lands
# there at launch, so 0.4.1's first Shield check walked another path. The app is now started
# with the launch extra com.tomdebres.hither.START_ON_TRENDING, which puts focus on Trending's
# first card (Recent Requests above it, under the bar, as after one Down); builds before it
# ignore the extra. 0.4.0-m4 and older have no row above Trending and need nothing. For 0.4.1
# itself on an account with requests, pass --down 1: one Down after the settle, before the
# first pass, takes focus from Recent Requests to Trending.
#
# --walk title (what scripts/measure-title runs; A4's walk, a script since A9): the same passes down a film's page
# instead, opened by its link (hither://title/movie/<id>, --title, default fake-seerr's recorded film 1423191). The
# actions, Down a stop at a time with a run along each shelf, then back up the same way: 64 presses, about 33 s. The
# same presses on any build; each reaches its own build's stops (0.6.5's overview, facts box, tags and cast; since A4
# the shelves), so the walk compares builds as a person walks them, not stop for stop (A4's report).
#
# Each summary also says how the app's code is compiled (`dumpsys package dexopt`: verify straight after an install,
# speed-profile once the baseline profile has been applied), since that moves every figure.
#
# The serial is required, so it never measures the wrong device. adb is $ADB, else the
# Android SDK's, else the one on PATH.
#
# Under pipefail a reader that stops early (head, grep -q, awk's exit, sed's q) fails the pipeline when the writer
# before it still had output (SIGPIPE), and set -e then ends the script with nothing said (A9). So a device's answer is
# read into a variable whole, and every first-match read is one sed or awk on a variable or a file, never a pipe into
# head.
set -euo pipefail

PKG=com.tomdebres.hither
serial=""
passes=2
out=""
settle=12
down=0
walk=discover
title=1423191
name=measure-discover
while [ $# -gt 0 ]; do
  case "$1" in
    -s) serial=$2; shift 2 ;;
    --passes) passes=$2; shift 2 ;;
    --out) out=$2; shift 2 ;;
    --settle) settle=$2; shift 2 ;;
    --down) down=$2; shift 2 ;;
    --walk) walk=$2; shift 2 ;;
    --title) title=$2; shift 2 ;;
    *) echo "usage: scripts/$name -s <serial> [--passes N] [--out DIR] [--settle S] [--down N] [--walk discover|title] [--title TMDB-ID]" >&2; exit 2 ;;
  esac
done
case "$walk" in
  discover) ;;
  title) name=measure-title ;;
  *) echo "$name: --walk is discover or title" >&2; exit 2 ;;
esac
[ -n "$serial" ] || { echo "$name: name the device with -s <serial> (adb devices)" >&2; exit 2; }

if [ -n "${ADB-}" ]; then
  adb_bin=$ADB
elif [ -x "${ANDROID_HOME:-$HOME/Library/Android/sdk}/platform-tools/adb" ]; then
  adb_bin="${ANDROID_HOME:-$HOME/Library/Android/sdk}/platform-tools/adb"
else
  adb_bin=adb
fi
dev() { "$adb_bin" -s "$serial" "$@"; }

out=${out:-"./$name-$(date +%Y%m%d-%H%M%S)"}
mkdir -p "$out"

dev get-state >/dev/null
package=$(dev shell dumpsys package "$PKG" | tr -d '\r')
version=$(sed -n '/versionName=/{s/.*versionName=\([^ ]*\).*/\1/p;q;}' <<<"$package")
[ -n "$version" ] || { echo "$name: $PKG is not installed on $serial" >&2; exit 1; }
model=$(dev shell getprop ro.product.model | tr -d '\r')
api=$(dev shell getprop ro.build.version.sdk | tr -d '\r')
dexopt=$(dev shell dumpsys package dexopt | tr -d '\r')
compiled=$(awk -v pkg="[$PKG]" '$1 == pkg { p = 1; next } p && /status=/ { sub(/^ */, ""); print; exit }' <<<"$dexopt")
if [ "$walk" = title ]; then
  started="on film $title's page (its link)"
else
  started="on Trending (extra; $down Down)"
fi
echo "$name: $PKG $version on $serial ($model, API $api), $passes passes, started $started, compiled ${compiled:-?}" | tee "$out/summary.txt"

# One key press is `input keyevent`, which starts a process on the device each time; the
# whole pass runs in one device shell so the pacing does not depend on the adb link.
press() { # <keycode> <times>
  local i
  for ((i = 0; i < $2; i++)); do printf 'input keyevent %s; sleep 0.5; ' "$1"; done
}
R=22 L=21 U=19 D=20
if [ "$walk" = title ]; then
  sequence="$(press $R 1)$(press $L 1)$(press $D 1)$(press $D 1)$(press $R 9)$(press $D 1)$(press $D 1)$(press $R 6)$(press $D 1)$(press $R 6)$(press $D 1)$(press $R 4)"
  sequence+="$(press $L 4)$(press $U 1)$(press $L 6)$(press $U 1)$(press $L 6)$(press $U 1)$(press $U 1)$(press $L 9)$(press $U 1)$(press $U 1)"
else
  sequence="$(press $R 10)$(press $D 1)$(press $R 10)$(press $D 1)$(press $R 6)$(press $D 1)$(press $R 6)"
  sequence+="$(press $L 6)$(press $U 1)$(press $L 6)$(press $U 1)$(press $L 10)$(press $U 1)$(press $L 10)"
fi

dev shell am force-stop "$PKG"
if [ "$walk" = title ]; then
  dev shell am start -W -a android.intent.action.VIEW -d "hither://title/movie/$title" -n "$PKG/.MainActivity" >/dev/null
else
  dev shell am start -W -n "$PKG/.MainActivity" --ez com.tomdebres.hither.START_ON_TRENDING true >/dev/null
fi
sleep "$settle"
# Only for a build before the extra whose account has rows above Trending (above): not measured.
if [ "$down" -gt 0 ]; then
  dev shell "$(press $D "$down")"
  sleep 2
fi

field() { # <dump> <label>: the number after "<label>:" on the first line that starts with it
  sed -n "/^$2:/{s/^$2: *\([0-9.]*\).*/\1/p;q;}" "$1"
}

# The UI thread's own time per frame (input, animation, composition, layout, recording the
# draw: HandleInputStart to SyncQueued in `gfxinfo framestats`), which a frame-time percentile
# hides wherever frames are capped at the vsync. framestats holds the last 120 frames, so it
# is read every second during a pass and the frames are joined by their vsync time.
ui_thread() { # <framestats dumps>: "<frames> frames, p50 X p90 Y p99 Z ms, total T ms"
  awk -F, '
    /^Flags,/ { for (i = 1; i <= NF; i++) col[$i] = i; next }
    col["Flags"] && $1 == "0" && NF > 10 {
      key = $col["IntendedVsync"]
      if (!(key in seen)) { seen[key] = 1; ms[n++] = ($col["SyncQueued"] - $col["HandleInputStart"]) / 1e6 }
    }
    END {
      if (n == 0) { print "no frames"; exit }
      for (i = 0; i < n; i++) for (j = i + 1; j < n; j++) if (ms[j] < ms[i]) { t = ms[i]; ms[i] = ms[j]; ms[j] = t }
      for (i = 0; i < n; i++) total += ms[i]
      printf "%d frames, p50 %.1f p90 %.1f p99 %.1f ms, total %.0f ms\n", n, ms[int(n * 0.5)], ms[int(n * 0.9)], ms[int(n * 0.99)], total
    }' "$@"
}

for ((pass = 1; pass <= passes + 1; pass++)); do
  sampled=$(( pass > passes ))
  host_load=$(uptime | sed 's/.*load averages*: *//')
  dev_load=$(dev shell cat /proc/loadavg | cut -d' ' -f1-3)
  dev shell dumpsys gfxinfo "$PKG" reset >/dev/null
  frames_raw="$out/framestats-pass$pass.txt"
  : > "$frames_raw"
  start=$(date +%s)
  dev shell "$sequence" &
  run=$!
  while [ "$sampled" = 1 ] && kill -0 "$run" 2>/dev/null; do
    dev shell dumpsys gfxinfo "$PKG" framestats | tr -d '\r' >> "$frames_raw"
    sleep 1
  done
  wait "$run"
  took=$(( $(date +%s) - start ))
  dump="$out/gfxinfo-pass$pass.txt"
  dev shell dumpsys gfxinfo "$PKG" framestats | tr -d '\r' > "$dump"
  cat "$dump" >> "$frames_raw"

  frames=$(field "$dump" 'Total frames rendered')
  janky=$(sed -n '/^Janky frames: *\([0-9]*\) (\([0-9.]*%\)).*/{s//\1 (\2)/p;q;}' "$dump")
  legacy=$(sed -n '/^Janky frames (legacy): *\([0-9]*\) (\([0-9.]*%\)).*/{s//\1 (\2)/p;q;}' "$dump")
  p50=$(field "$dump" '50th percentile'); p90=$(field "$dump" '90th percentile')
  p95=$(field "$dump" '95th percentile'); p99=$(field "$dump" '99th percentile')
  slow_ui=$(field "$dump" 'Number Slow UI thread')
  deadline=$(field "$dump" 'Number Frame deadline missed')
  gpu50=$(field "$dump" '50th gpu percentile'); gpu90=$(field "$dump" '90th gpu percentile')
  # An emulator has no GPU timings: it reports every frame in the last bucket.
  [ "${gpu50:-}" = 4950 ] && gpu50=n/a && gpu90=n/a
  # The image textures the app's renderer holds: posters, and anything else drawn from a bitmap.
  textures=$(awk '/^  Image:/{i=1; next} i && /Texture:/{print; exit} /^  [A-Z]/{i=0}' "$dump" | sed 's/^ *//')

  if [ "$sampled" = 1 ]; then
    line="pass $pass (sampled): ${took}s, UI thread: $(ui_thread "$frames_raw")"
    line+=" | host load $host_load | device load $dev_load"
    echo "$line" | tee -a "$out/summary.txt"
    continue
  fi
  line="pass $pass: ${took}s, $frames frames, janky ${janky:-?}"
  [ -n "$legacy" ] && line+=", janky legacy $legacy"
  line+=", p50 ${p50}ms p90 ${p90}ms p95 ${p95}ms p99 ${p99}ms, slow UI ${slow_ui:-?}, deadline missed ${deadline:-?}"
  line+=", gpu p50 ${gpu50:-?} p90 ${gpu90:-?}, images: ${textures:-none}"
  line+=" | host load $host_load | device load $dev_load"
  echo "$line" | tee -a "$out/summary.txt"
done
echo "$name: dumps in $out"
